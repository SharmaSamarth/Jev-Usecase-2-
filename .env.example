# Copy to .env for local development. Never commit .env.

# --- Claude Sonnet: choose ONE platform ----------------------------------
# Platform is inferred from the credential you set; force it with
# CLAUDE_PLATFORM=anthropic | bedrock if both are present.
# CLAUDE_PLATFORM=bedrock

# Option A - Amazon Bedrock (Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-north-1
# Bedrock model ids are prefixed with "anthropic." (default: anthropic.claude-sonnet-5-5).
# Some regions (e.g. eu-north-1) only serve the model through a cross-region
# inference profile: use eu.anthropic.claude-sonnet-5-5 (EU-only routing) or
# global.anthropic.claude-sonnet-5-5.
# ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-5-5
# Bedrock endpoint: runtime (InvokeModel, default; supports inference profiles)
# or mantle (Bedrock Messages API, where the model is offered in your region).
# BEDROCK_ENDPOINT=runtime

# Option B - Anthropic API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Request settings (both platforms) ------------------------------------
# Thinking effort: low | medium | high | xhigh | max. Low keeps classification fast and consistent.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60
# SDK retries for 429 / 5xx / timeouts / connection errors (exponential backoff).
ANTHROPIC_MAX_RETRIES=2
# Extra requests allowed when the model output fails validation (0 disables repair).
CLASSIFIER_MAX_REPAIR_ATTEMPTS=1

# Price overrides in USD per million tokens. Anthropic API defaults come from
# config.ANTHROPIC_PRICING. On Bedrock no default is applied (Bedrock has its
# own pricing); set these from the AWS Bedrock pricing page to get cost estimates.
# ANTHROPIC_PRICE_INPUT_PER_MTOK=
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
# ANTHROPIC_PRICE_CACHE_WRITE_PER_MTOK=
# ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=

# --- Evaluation -----------------------------------------------------------
EVAL_CONCURRENCY=4
REPORTS_DIR=reports
# Local result cache: an email already classified with the same model, platform,
# effort and prompt is never sent again. Set to off to always call the API.
CLASSIFIER_CACHE=on
CLASSIFIER_CACHE_DIR=.cache/classifications

# --- Jev (TypeSafe AI) ----------------------------------------------------
# Requires the official SDK on the machine that runs Jev: pip install -e ".[jev]"
TYPESAFE_API_KEY=
# Model alias or pinned version (the response records the version that answered).
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=30
# JEV_MAX_RETRIES=2
# Probability from Jev's yes/no "needs human review" question at or above which
# human_review_required is true.
# JEV_REVIEW_THRESHOLD=0.5
# Price in USD per million billable input tokens, from TypeSafe's pricing
# (output tokens are documented as currently free). Without it, cost shows n/a.
# JEV_PRICE_INPUT_PER_MTOK=
# JEV_PRICE_OUTPUT_PER_MTOK=0
